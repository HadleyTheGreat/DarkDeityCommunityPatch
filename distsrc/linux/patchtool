#!/bin/bash

################################################################################
# Dark Deity Community Patch installation and removal tool for Linux.
################################################################################

# Enforce strict error handling
set -euo pipefail

# Script global variables
SCRIPT_NAME=$(basename "$0")
VERSION="3.0.0"
VERBOSE_OUTPUT=false
APPID="1374840"
GAME_DIR=""
BACKUP_DIR=""
PATCH_DIR=""
ACTION=""
OVERRIDE=false
PROMPT=false

# Get the directory where the script is located
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$BASE_DIR/scripts"

# Default Steam locations on Linux
STEAM_ROOTS=(
    "$HOME/.steam/steam"
    "$HOME/.steam/root"
    "$HOME/.local/share/Steam"
)

# Global hash variables
prePatchHash=""
postPatchHash=""

# Initialize color variables as empty strings (fallback for no color)
RED=""
GREEN=""
YELLOW=""
BLUE=""
MAGENTA=""
CYAN=""
WHITE=""
NC="" # No Color (Reset)

if [[ -t 1 ]] && tput colors &>/dev/null && [[ "$(tput colors)" -ge 8 ]]; then
    RED="$(tput bold;tput setaf 1)"
    GREEN="$(tput bold;tput setaf 2)"
    YELLOW="$(tput bold;tput setaf 3)"
    BLUE="$(tput bold;tput setaf 4)"
    MAGENTA="$(tput setaf 5)"
    CYAN="$(tput setaf 6)"
    WHITE="$(tput setaf 7)"
    NC="$(tput sgr0)"
fi

brief_usage() {
    cat << EOF
Dark Deity Community Patch installation and removal tool for Linux
Usage:
  ./$SCRIPT_NAME COMMAND [OPTIONS]                # auto-locate in Steam
  ./$SCRIPT_NAME COMMAND [OPTIONS] -p             # gui prompt for directory
  ./$SCRIPT_NAME COMMAND [OPTIONS] -d DIRECTORY  # specify Dark Deity directory
COMMAND can be one of:
  -h, -?, --help  Show the help    
  -i, --install   Install the patch
  -u, --uninstall Uninstall the patch
  -a, --auto      Interactively prompt to either uninstall or install 
                  based on the current patched state
  -q, --query     Query the current patch state of Dark Deity  
  -c, --hash      Calculate the SHA256 hash of Dark Deity's data.win file
OPTIONS can be zero or more of:
  -o, --override  Ignore version mismatch and attempt to patch anyway
  -v, --verbose   Show verbose output
DIRECTORY should be enclosed in quotation marks if it contains spaces.
EOF
}

show_examples() {
    cat << EOF    
Examples:
  ./$SCRIPT_NAME -a
  ./$SCRIPT_NAME -i -p
  ./$SCRIPT_NAME -i -d "$HOME/.local/share/Dark Deity"
  ./$SCRIPT_NAME -u -d ~/.steam/Steam/steamapps/common/"Dark Deity"
  ./$SCRIPT_NAME --hash "/usr/local/games/Dark Deity"
EOF
}

show_usage() {
    brief_usage
    show_examples
}

find_library_folders_vdf() {
    for root in "${STEAM_ROOTS[@]}"; do
        local vdf_path="$root/steamapps/libraryfolders.vdf"
        if [[ -f "$vdf_path" ]]; then
            echo "$vdf_path"
            return 0
        fi
    done
    return 1
}

get_library_paths() {
    local vdf="$1"
    grep -E '^[[:space:]]*"path"' "$vdf" |
    sed -E 's/.*"path"[[:space:]]*"([^"]+)".*/\1/' |
    sed 's#\\\\#/#g'
}

find_game_dir() {
    local appid="$1"
    local vdf

    vdf=$(find_library_folders_vdf || true)
    if [[ -z "$vdf" ]]; then
        echo "Steam libraryfolders.vdf not found" >&2
        return 1
    fi

    while IFS= read -r library; do
        local steamapps="$library/steamapps"
        local manifest="$steamapps/appmanifest_${appid}.acf"
        local installdir

        if [[ -f "$manifest" ]]; then
            installdir=$(awk -F'"' '$2=="installdir" { print $4; exit }' "$manifest")
            if [[ -n "$installdir" ]]; then
                echo "$steamapps/common/$installdir"
                return 0
            fi
        fi
    done < <(get_library_paths "$vdf")

    return 1
}

install_files_with_backup() {
    local source_dir="$BASE_DIR/files"
    local added_files="$PATCH_DIR/addedfiles.txt"
    
    if [[ ! -d "$source_dir" ]]; then
        echo "${RED}Error: No files found in source directory.${NC}" 
        exit 1 
    fi
    
    mkdir -p "$PATCH_DIR"
    mkdir -p "$BACKUP_DIR"
    : > "$added_files"    
    
    while read -r source_path; do
        local rel_path="${source_path#$source_dir/}"
        local destination_path="$GAME_DIR/$rel_path"
        local backup_path="$BACKUP_DIR/$rel_path"
        
        mkdir -p "$(dirname "$destination_path")"
        
        if [[ -f "$destination_path" ]]; then
            if [[ ! -f "$backup_path" ]]; then
                mkdir -p "$(dirname "$backup_path")"
                if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "$rel_path"; fi
                mv "$destination_path" "$backup_path"
            fi
        else
            if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "$rel_path"; fi
            echo "$rel_path" >> "$added_files"
        fi
        
        cp "$source_path" "$destination_path"
    done < <(find "$source_dir" -type f | sort)
}

uninstall_files_from_backup() {
    if [[ -z "$GAME_DIR" ]]; then
        echo "${RED}Error: Game directory was unset.${NC}" 
        return 1
    fi
    
    local added_files="$PATCH_DIR/addedfiles.txt"
    
    if [[ -d "$BACKUP_DIR" ]]; then
        echo "--- Restoring previous version files from backup ---"
        if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "BACKUP_DIR = $BACKUP_DIR"; fi
        
        while IFS= read -r backup_file; do        
            local rel_path="${backup_file#$BACKUP_DIR/}"
            local target_path="$GAME_DIR/$rel_path"
            
            if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "$rel_path"; fi
            mkdir -p "$(dirname "$target_path")"
            mv "$backup_file" "$target_path"
        done < <(find "$BACKUP_DIR" -type f)    
        
        rm -rf "${BACKUP_DIR:?}"
    else
        if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "Backup directory '$BACKUP_DIR' does not exist. Nothing to restore there."; fi
    fi
    
    echo "--- Deleting new files added by the patch ---"
    if [[ -f "$added_files" ]]; then
        if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "Reading file deletion list from '$added_files'..."; fi
        
        while IFS= read -r file; do
            if [[ -z "$file" || "$file" =~ ^[[:space:]]*$ ]]; then continue; fi
            
            local full_path
            if [[ "$file" = /* ]]; then
                full_path="$file"
            else
                full_path="$GAME_DIR/$file"
            fi
            
            if [[ -f "$full_path" ]]; then
                rm -f "$full_path"
                if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "Deleted: $file"; fi
            else
                if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "Skipped (File not found): $file"; fi
            fi
        done < "$added_files"
    else
        if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "File list '$added_files' not found. Skipping deletions."; fi
    fi
}

legacy_install_is_present() {
    local data_win_old="$GAME_DIR/data.win.old"
    local remove_script="$GAME_DIR/removepatch.sh"
    local remove_script_2="$GAME_DIR/removepatch.bat"
    if [[ -f "$data_win_old" ]] || [[ -f "$remove_script" ]] || [[ -f "$remove_script_2" ]]; then
        return 0
    else
        return 1
    fi
}

do_legacy_uninstall() {
    local data_win_old="$GAME_DIR/data.win.old"
    local data_win="$GAME_DIR/data.win"
    local remove_script="$GAME_DIR/removepatch.sh"
    local remove_script_2="$GAME_DIR/removepatch.bat"
    
    if [[ -f "$data_win_old" ]] || [[ -f "$remove_script" ]] || [[ -f "$remove_script_2" ]]; then
        echo "--- Removing legacy install files ---"
        
        if [[ -f "$data_win_old" ]]; then
            if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "Removing: $data_win_old"; fi
            rm -f "$data_win"
            mv "$data_win_old" "$data_win"
        fi
        
        if [[ -f "$remove_script" ]]; then
            if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "Removing: $remove_script"; fi
            rm -f "$remove_script"
        fi

        if [[ -f "$remove_script_2" ]]; then
            if [[ "$VERBOSE_OUTPUT" == "true" ]]; then echo "Removing: $remove_script_2"; fi
            rm -f "$remove_script_2"
        fi
    fi
}

do_uninstall() {
    if [[ -d "$BACKUP_DIR" ]]; then
        uninstall_files_from_backup
    fi
    
    if [[ -d "$PATCH_DIR" ]]; then
        echo "--- Removing patch folder ---"
        rm -rf "${PATCH_DIR:?}"
    fi
    
    do_legacy_uninstall
}

do_install() {
    local unpatched_data="$GAME_DIR/data.win"
    local patched_data="$BASE_DIR/files/data.win"
    
    echo "--- Rebuilding data.win ---"
    [[ -f "$patched_data" ]] && rm -f "$patched_data"
    
    local utmt_cli="$BASE_DIR/utmt_cli/UndertaleModCli"
    local script1="$BASE_DIR/scripts/nongmlmods.csx"
    local script2="$BASE_DIR/scripts/scriptupdater.csx"
    
    if ! "$utmt_cli" load "$unpatched_data" -s "$script1" -s "$script2" -o "$patched_data"; then
        echo "${RED}Error: UndertaleModCli failed execution.${NC}" 
        return 1
    fi
    
    echo "--- Installing patch files ---"
    install_files_with_backup
}

do_version() {
    echo "$VERSION"
}

do_hash() {
    local current_file="$GAME_DIR/data.win"
    local old_file="$GAME_DIR/data.win.old"
    
    if [[ ! -f "$current_file" ]]; then
        echo "${RED}Error: Couldn't find file \"$current_file\".${NC}" 
        return 1
    fi
    
    local current_hash
    current_hash=$(sha256sum "$current_file" | awk '{print $1}')
    echo "data.win: $current_hash"
    
    if [[ -f "$old_file" ]]; then
        local backup_hash
        backup_hash=$(sha256sum "$old_file" | awk '{print $1}')
        echo "data.win.old: $backup_hash"
    fi
}

prompt_for_game_dir() {
    local selected

    if command -v zenity &> /dev/null; then
        selected=$(zenity \
            --file-selection \
            --directory \
            --title="Please locate the Dark Deity game directory" \
            --filename="$HOME/" 2>/dev/null) || return 1
    elif command -v kdialog &> /dev/null; then
        selected=$(kdialog \
            --getexistingdirectory "$HOME/" \
            --title="Please locate the Dark Deity game directory" 2>/dev/null) || return 1
    else
        echo "${RED}Error: No GUI dialog tool found (zenity or kdialog required).${NC}" 
        return 1
    fi

    echo "$selected"
}

resolve_game_dir() {
    if [[ "$PROMPT" == "true" ]]; then
        if ! GAME_DIR=$(prompt_for_game_dir); then
            echo "${YELLOW}Prompt for game directory was cancelled. Operation aborted.${NC}"
            return 1
        fi
    else
        if [[ -z "$GAME_DIR" ]]; then
            if ! GAME_DIR=$(find_game_dir "$APPID"); then
                echo "Failed to locate Dark Deity in Steam."
                GAME_DIR=""
            fi
        fi
        if [[ -z "$GAME_DIR" ]]; then
            if ! GAME_DIR=$(prompt_for_game_dir); then
                echo "${YELLOW}Prompt for game directory was cancelled. Operation aborted.${NC}"
                return 1
            fi
        fi
    fi
    
    if [[ -z "$GAME_DIR" ]]; then
        echo "${RED}Error: Failed to locate the Dark Deity game directory.${NC}"
        echo "Use [-d directory] to specify it on the command-line or [-p]"
        echo "to prompt for it interactively."
        echo "Examples:"
        echo "    ./$SCRIPT_NAME -i -d ~/.steam/steam/steamapps/common/\"Dark Deity\""
        echo "    ./$SCRIPT_NAME -i -p"
        echo "    ./$SCRIPT_NAME -u -d \"\$HOME/.steam/steam/steamapps/common/Dark Deity\""
        return 1
    fi
    
    echo "GAME_DIR = \"$GAME_DIR\""
    if [[ ! -d "$GAME_DIR" ]]; then
        echo "${RED}Error: Specified game directory does not exist.${NC}"
        return 1
    fi
      
    local current_file="$GAME_DIR/data.win"
    if [[ ! -f "$current_file" ]]; then
        echo "${RED}Error: File not found \"$current_file\".${NC}" 
        return 1
    fi
    
    PATCH_DIR="$GAME_DIR/patch"
    BACKUP_DIR="$PATCH_DIR/backup"
}

validate_post_hash() {
    if [[ -z "$postPatchHash" ]] || [[ "$OVERRIDE" == "true" ]]; then
        return 0
    fi
    
    echo "--- Validating data.win ---"
    local current_file="$GAME_DIR/data.win"
    local current_hash
    current_hash=$(sha256sum "$current_file" | awk '{print $1}')
    
    if [[ "$current_hash" == "$postPatchHash" ]]; then
        echo "Post-patch hash validation passed."
        return 0
    else
        echo "Expected hash: $postPatchHash"
        echo "Actual hash: $current_hash"
        echo "${RED}Post-patch hash validation failed.${NC}" 
        return 1
    fi
}

get_install_state() {
    if [[ ! -d "$SCRIPTS_DIR" ]]; then
        echo "${RED}Error: Scripts directory missing at \"$SCRIPTS_DIR\"${NC}." >&2
        return 1
    fi
    
    local hash_file="$SCRIPTS_DIR/versions.csv"
    if [[ ! -f "$hash_file" ]]; then
        echo "${RED}Error: Versions file is missing at \"$hash_file\".${NC}" >&2
        return 1
    fi
    
    if legacy_install_is_present; then
        echo "3"
        return 0
    fi
    
    local input_file="$GAME_DIR/data.win"
    local current_hash
    current_hash=$(sha256sum "$input_file" | awk '{print $1}')
    
    while IFS=, read -r name before_hash after_hash; do
        name=${name//\"/}
        before_hash=${before_hash//\"/}
        after_hash=${after_hash//\"/}
    
        if [[ "$after_hash" == "$current_hash" ]]; then
            echo "1"
            return 0
        elif [[ "$before_hash" == "$current_hash" ]]; then
            postPatchHash="$after_hash"
            prePatchHash="$before_hash"
            echo "2"
            return 0
        fi
    done < <(tail -n +2 "$hash_file")
        
    if [[ -d "$PATCH_DIR" ]]; then
        echo "3"
        return 0
    fi
    
    echo "0"
    return 0
}

prompt_for_uninstall() {
    echo "This patch is already installed." 
    read -p "Do you want to uninstall the patch? (y/N): " -n 1 -r
    echo
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        do_uninstall
        echo "${GREEN}The patch was successfully uninstalled.${NC}"
        exit 0
    else
        echo "${YELLOW}You chose No.  No changes have been made.${NC}"
        exit 0
    fi
}

prompt_for_reinstall() {
    echo "A different version of the patch is currently installed."
    read -p "Do you want to replace it with this version? (y/N): " -n 1 -r
    echo
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        do_uninstall
        local state
        state=$(get_install_state)
        
        if [[ "$state" == "0" ]]; then
            echo "${RED}Error: Dark Deity version mismatch.${NC}"
            echo "This patch is intended only for version 1.58 of Dark Deity."
            exit 1
        fi
        
        if [[ "$state" != "2" ]]; then
            echo "${RED}Error: Previous patch removal resulted in an inconsistent state.${NC}"
            echo "Please uninstall and reinstall Dark Deity or validate the integrity of the install."
            exit 1
        fi
        
        do_install
        validate_post_hash
        echo "${GREEN}The patch installation was successful.${NC}"
        exit 0
    else
        echo "${YELLOW}You chose No.  No changes have been made.${NC}"
        exit 0
    fi
}

prompt_for_install() {
    echo "The patch is not currently installed."
    echo "This version of Dark Deity is supported." 
    read -p "Do you want to install the patch? (y/N): " -n 1 -r
    echo
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        do_install
        validate_post_hash
        echo "${GREEN}The patch installation was successful.${NC}"
        exit 0
    else
        echo "${YELLOW}You chose No.  No changes have been made.${NC}"
        exit 0
    fi
}

prompt_for_override_install() {
    echo "The patch is not currently installed."
    echo "The patch is not intended for this version of Dark Deity."
    read -p "Do you want to override and install the patch anyway? (y/N): " -n 1 -r
    echo
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        do_install
        echo "${GREEN}The patch installation was successful.${NC}"
        exit 0
    else
        echo "${YELLOW}You chose No.  No changes have been made.${NC}"
        exit 0
    fi
}

main_process() {
    case "$ACTION" in
        auto)
            resolve_game_dir
            local state
            state=$(get_install_state)
            
            case "$state" in
                0) prompt_for_override_install ;;
                1) prompt_for_uninstall ;;
                2) prompt_for_install ;;
                3) prompt_for_reinstall ;;
            esac
            exit 0
            ;;
        
        install)
            resolve_game_dir
            local state
            state=$(get_install_state)
            
            if [[ "$state" == "3" ]]; then
                do_uninstall
                state=$(get_install_state)
            fi
            
            if [[ "$state" == "1" ]]; then
                echo "${YELLOW}The patch is already installed. Nothing to do.${NC}" 
                exit 0
            fi
            
            if [[ "$state" == "0" ]] && [[ "$OVERRIDE" != "true" ]]; then
                echo "${RED}Dark Deity version mismatch. Operation aborted.${NC}" 
                exit 1
            fi
            
            if [[ "$state" == "2" ]]; then
                do_install
                validate_post_hash
                echo "${GREEN}The patch installation was successful.${NC}"
                exit 0
            fi
            ;;
        
        uninstall)
            resolve_game_dir
            local state
            state=$(get_install_state)
            
            case "$state" in
                1|3)
                    do_uninstall
                    echo "${GREEN}The patch was successfully uninstalled.${NC}"
                    exit 0
                    ;;
                2)
                    echo "${YELLOW}The patch is not currently installed.${NC}"
                    echo "The patch supports this version of Dark Deity." 
                    ;;
                0)
                    echo "${YELLOW}The patch is not currently installed.${NC}"
                    echo "The patch does not support this version of Dark Deity."
                    exit 0
                    ;;
            esac
            ;;
        
        query)
            resolve_game_dir
            local state
            state=$(get_install_state)          
            
            case "$state" in
                0)
                    echo "${YELLOW}The patch is not currently installed.${NC}"
                    echo "The patch does not support this version of Dark Deity."
                    exit 0
                    ;;
                3)
                    echo "${YELLOW}A different version of the patch is currently installed.${NC}"
                    exit 0
                    ;;
                2)
                    echo "${YELLOW}The patch is not currently installed.${NC}"
                    echo "The patch supports this version of Dark Deity." 
                    exit 0
                    ;;
                1)
                    echo "${YELLOW}The patch is already installed.${NC}"
                    exit 0
                    ;;
            esac
            ;;
        
        help)
            show_usage
            ;;
        
        hash)
            resolve_game_dir
            do_hash
            ;;
        
        version)
            do_version
            ;;
        
        *)
            echo "${RED}Error: Internal error - No handler for command \"$ACTION\".${NC}" 
            exit 1
            ;;
    esac
}

set_action() {
    if [[ -z "$ACTION" ]]; then
        ACTION=$1
        return 0
    else
        echo "${RED}Error: More than one command switch specified.${NC}"
        return 1
    fi
}

parse_params() {
    while [[ $# -gt 0 ]]; do
        local arg="$1"
        
        case "$arg" in
            -h|-\?|--help)
                set_action "help"
                shift
                ;;
            -a|--auto)
                set_action "auto"
                shift
                ;;
            -i|--install)
                set_action "install"
                shift
                ;;
            -u|--uninstall)
                set_action "uninstall"
                shift
                ;;
            -c|--hash)
                set_action "hash"
                shift
                ;;
            --version)
                set_action "version"
                shift
                ;;
            -q|--query)
                set_action "query"
                shift
                ;;
            -v|--verbose)
                VERBOSE_OUTPUT=true
                shift
                ;;
            -o|--override)
                OVERRIDE=true
                shift
                ;;
            -p|--prompt)
                PROMPT=true
                shift
                ;;
            -d|--directory)
                if [[ $# -lt 2 ]]; then
                    echo "${RED}Error: missing directory after \"$1\".${NC}"
                    exit 1
                fi
                if [[ -z "$2" ]]; then
                    echo "${RED}Error: directory argument is empty.${NC}"
                    exit 1
                fi
                
                GAME_DIR="$2"
                shift 2
                ;;
            -*)
                echo "${RED}Error: Unrecognized command or option \"$arg\".${NC}"
                brief_usage
                exit 1
                ;;
            *)
                echo "${RED}Error: Unexpected argument \"$arg\".${NC}"
                echo "Be sure to enclose directory paths with quotation marks if they contain spaces."
                echo "Examples:"
                echo "  ./$SCRIPT_NAME -i -d \"\$HOME/.local/share/Steam/steamapps/common/Dark Deity\""
                echo "  ./$SCRIPT_NAME -u -d ~/.local/share/Steam/steamapps/common/\"Dark Deity\""     
                exit 1
                ;;
        esac
    done
}

parse_params "$@"

if [[ -z "$ACTION" ]]; then
    echo "${RED}Error: No command specified.${NC}"
    show_usage
    exit 1
fi

main_process
