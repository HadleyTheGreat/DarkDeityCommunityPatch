#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status,
# treat unset variables as an error, and catch pipeline failures.
set -euo pipefail

# Script global variables
SCRIPT_NAME=$(basename "$0")
VERSION="3.0.0"
VERBOSE=false
APPID="1374840"
GAME_DIR=""
ACTION=""

# Default install locations for Steam
STEAM_ROOTS=(
    "$HOME/.local/share/Steam"
    "$HOME/.steam/steam"
)

# Display usage instructions
usage() {
    cat << EOF
Dark Deity Community Patch installation and removal tool for Steam on Linux
Version ${VERSION}

This patch should support SteamOS, Ubuntu, and most other x86-based Linux distributions

Usage: 
    ${SCRIPT_NAME} -i [path]   Install the Dark Deity community patch.
    ${SCRIPT_NAME} -u [path]   Uninstall the Dark Deity community patch.
    ${SCRIPT_NAME} --version    Display the version of the community patch and exit.
    ${SCRIPT_NAME} -h          Display this help message and exit.

[path] is optional.
The tool will try to locate the Dark Deity install directory automatically.
If that fails for any reason, you can provide the path manually.

Examples:
${SCRIPT_NAME} -i "$HOME/.steam/steam/steamapps/common/Dark Deity"
${SCRIPT_NAME} -u ~/.steam/steam/steamapps/common/"Dark Deity"
${SCRIPT_NAME} -i "/usr/games/Dark Deity"
EOF
}

find_libraryfolders_vdf() {
    for root in "${STEAM_ROOTS[@]}"; do
        if [[ -f "$root/steamapps/libraryfolders.vdf" ]]; then
            echo "$root/steamapps/libraryfolders.vdf"
            return 0
        fi
    done
    return 1
}

get_library_paths() {
    local vdf="$1"

    # Extract all "path" entries
    grep -E '^[[:space:]]*"path"' "$vdf" |
    sed -E 's/.*"path"[[:space:]]*"([^"]+)".*/\1/' |
    sed 's#\\\\#/#g'
}

find_game_dir() {
    local appid="$1"
    local vdf

    vdf=$(find_libraryfolders_vdf) || {
        echo "Steam libraryfolders.vdf not found" >&2
        return 1
    }

    while IFS= read -r library; do
        local steamapps="$library/steamapps"
        local manifest="$steamapps/appmanifest_${appid}.acf"
        local installdir

        if [[ -f "$manifest" ]]; then
            installdir=$(grep '"installdir"' "$manifest" |
                sed -E 's/.*"installdir"[[:space:]]*"([^"]+)".*/\1/')

            if [[ -n "$installdir" ]]; then
                echo "$steamapps/common/$installdir"
                return 0
            fi
        fi
    done < <(get_library_paths "$vdf")

    return 1
}

do_uninstall() {
	if [[ -f "${GAME_DIR}/data.win.old" ]]; then
		echo "--- Uninstalling existing patch ---"
		rm -f "${GAME_DIR}/data.win"
		mv "${GAME_DIR}/data.win.old" "${GAME_DIR}/data.win"
	fi
}

do_version() {
	echo "$VERSION"
}

do_hash() {
	echo "Error: hash checking is not yet implemented." >&2
	return 1
}

validate_gamedir() {
	if [[ -z "$GAME_DIR" ]]; then
		if ! GAME_DIR=$(find_game_dir "$APPID"); then
	 		cat << EOF >&2
Error: Failed to automatically locate the Dark Deity install folder.
If you can locate the directory, you can specify it manually.
Examples:
    ${SCRIPT_NAME} -i "$HOME/.steam/steam/steamapps/common/Dark Deity"
    ${SCRIPT_NAME} -u "/usr/games/steam/steamapps/common/Dark Deity"
EOF
			return 1
		fi	
	fi
	
	if [[ ! -f "$GAME_DIR/data.win" ]]; then
		echo "Error: file not found \"$GAME_DIR/data.win\""
		return 1
	fi
	
	echo "GAME_DIR = $GAME_DIR"
}

set_action() {
    if [[ -n "$ACTION" ]]; then 
        echo "Error: More than one command specified in arguments." >&2
        return 1
    fi
    ACTION="$1"
}
   	
# Main application logic
main() {
	case "$ACTION" in
		"install")
			validate_gamedir
			do_install
			;;
		"uninstall")
			validate_gamedir
			if [[ ! -f "$GAME_DIR/data.win.old" ]]; then
				cat << EOF 
There is no backup file "$GAME_DIR/data.win.old".
Either:
   1) The patch was never installed.
   2) The patch was installed but it has already been uninstalled.
   3) The patch is still installed but you deleted the backup file.
If your problem is #3 then to uninstall you should:
   - Go to your Library in Steam
   - Right-click Dark Deity and select Properties->Installed Files
   - Click on Verify integrity of game files
   This will cause Steam to check the game files and re-download data.win if necesary.
EOF
			fi
			;;
		"help")
			usage
			;;
		"hash")
			do_hash
			;;
		"version")
			do_version
			;;
		*)
			echo "Internal error: No handler for command \"$ACTION\"" >&2
			return 1
			;;
	esac
}

do_install() {
    echo "--- Building patched.win ---"
    rm -f "${GAME_DIR}/patched.win"
    utmt_cli/UndertaleModCli load "${GAME_DIR}/data.win" -s "scripts/nongmlmods.csx" -s "tools/scriptupdater.csx" -o "${GAME_DIR}/patched.win"
    echo "--- Renaming data.win to data.win.old to save as a backup ---"
    rm -f "${GAME_DIR}/data.win.old"
    mv "$GAME_DIR/data.win" "$GAME_DIR/data.win.old"
    echo "--- Renaming patched.win to data.win ---"
    mv "$GAME_DIR/patched.win" "$GAME_DIR/data.win"
    echo -e "\033[32mPatch was installed successfully.\033[0m"				
}


# Parse command-line arguments safely
parse_params() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        	#  --- COMMANDS ---
            -h|-\?|--help)
            	shift 
            	set_action "help"
            	;; 
            -i|--install)
            	shift
            	set_action "install";
            	;;
            -u|--uninstall)
            	shift
            	set_action "uninstall";
            	;;
            -c|--hash)
            	shift
            	set_action "hash";
            	;;
            --version)
            	shift
            	set_action "version";
            	;;
            	
            # --- OPTIONS ---
            # verbose is not currently used but it is implemented here for possible future use
            -v|--verbose)
                shift
                VERBOSE=true
                ;;

			-*)
				echo "Error: Unrecognized argument \"$1\"." >&2
				return 1
				;;
			*)	
				if [[ -z "$ACTION" ]]; then
					echo "Error: Command switch missing." >&2
					return 1
				fi
				
				if [[ "$ACTION" = "install" || "$ACTION" = "uninstall" || "$ACTION" = "hash" ]]; then		
					if [[ $# -gt 1 ]]; then
						echo "Error: Optional path argument must be the last argument." >&2
						echo "If you want use a path with a space in it, be sure to enclose it in quotation marks." >&2
						return 1
					fi

					GAME_DIR="$1"
				else
					echo "Error: Unexpected argument \"$1\"." >&2
					return 1
				fi
				shift
				;;
        esac
    done
}

# Script entry point
parse_params "$@"
main "$@"
