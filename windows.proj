<Project DefaultTargets="Release" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<GameDir></GameDir>
		<DistRoot>$(MSBuildProjectDirectory)\dist</DistRoot>
		<DistDir>$(DistRoot)\windows</DistDir>
		<ScriptsDir>$(DistDir)\scripts</ScriptsDir>
		<ToolsDir>$(DistDir)\tools</ToolsDir>
		<DistSrcDir>$(MSBuildProjectDirectory)\distsrc</DistSrcDir>
		<ArtifactsDir>$(MSBuildProjectDirectory)\artifacts</ArtifactsDir>
		<UtmtCliDir>$(DistDir)\utmt_cli</UtmtCliDir>
		<ImportsDir>$(MSBuildProjectDirectory)\imports</ImportsDir>
		<DistVersion>3.0.0</DistVersion>
		<ReleaseZipFile>$(ArtifactsDir)\DarkDeityCommunityPatch-$(DistVersion)-Windows.zip</ReleaseZipFile>
		<UtmtCliUrlWindows>https://github.com/UnderminersTeam/UndertaleModTool/releases/download/0.9.1.2/UTMT_CLI_v0.9.1.2-Windows.zip</UtmtCliUrlWindows>
		<UtmtCliUrlLinux>https://github.com/UnderminersTeam/UndertaleModTool/releases/download/0.9.1.2/UTMT_CLI_v0.9.1.2-Ubuntu.zip</UtmtCliUrlLinux>
		<UtmtCliZipFileWindows>$(ImportsDir)\utmt_cli.zip</UtmtCliZipFileWindows>
		<UtmtCliZipFileLinux>$(ImportsDir)\utmt_cli_linux.zip</UtmtCliZipFileLinux>
	</PropertyGroup>

	<PropertyGroup
		Condition="$([MSBuild]::IsOSPlatform('Windows'))">

		<Curl>curl.exe</Curl>
		<LocalUtmtDir>$(ImportsDir)\utmt_cli</LocalUtmtDir>
		<Utmt>$(LocalUtmtDir)\UndertaleModCli.exe</Utmt>
		<BuildToolsDir>$(DistSrcDir)\windows\buildtools</BuildToolsDir>
	</PropertyGroup>

	<PropertyGroup
		Condition="$([MSBuild]::IsOSPlatform('Linux'))">

		<Curl>curl</Curl>
		<LocalUtmtDir>$(ImportsDir)\utmt_cli_linux</LocalUtmtDir>
		<Utmt>$(LocalUtmtDir)\UndertaleModCli</Utmt>
		<BuildToolsDir>$(DistSrcDir)\linux\buildtools</BuildToolsDir>
	</PropertyGroup>

	<ItemGroup>
		<DistCommonSources
			Include="$(MSBuildProjectDirectory)\distsrc\**\*"
			Exclude="$(MSBuildProjectDirectory)\distsrc\windows\**\*;$(MSBuildProjectDirectory)\distsrc\linux\**\*;$(MSBuildProjectDirectory)\distsrc\**\.gitignore" />

		<DistWindowsSources
			Include="$(MSBuildProjectDirectory)\distsrc\windows\**\*"
			Exclude="$(MSBuildProjectDirectory)\distsrc\windows\**\.gitignore;$(MSBuildProjectDirectory)\distsrc\windows\buildtools\**\*" />

		<DistSources Include="@(DistCommonSources);@(DistWindowsSources)" />
		<Distro Include="Steam"/>
		<Distro Include="GOG"/>
		<Distro Include="Epic Games"/>
		<!-- <Distro Include="Epic Games"/> -->
	</ItemGroup>

	<Target
		Name="DistDownloadImportsWindows"
		BeforeTargets="ExtractCLITools;DistExtractImports"
		Condition="!Exists('$(UtmtCliZipFileWindows)')">

		<MakeDir Directories="$(ImportsDir)" />
		<Exec
			Command='$(Curl) -L "$(UtmtCliUrlWindows)" -o "$(UtmtCliZipFileWindows)"'
			ConsoleToMSBuild="true" />
	</Target>

	<Target
		Name="DistDownloadImportsLinux"
		BeforeTargets="ExtractCLITools"
		Condition="!Exists('$(UtmtCliZipFileLinux)')">

		<MakeDir Directories="$(ImportsDir)" />
		<Exec
			Command='$(Curl) -L "$(UtmtCliUrlLinux)" -o "$(UtmtCliZipFileLinux)"'
			ConsoleToMSBuild="true" />
	</Target>

	<Target
		Name="ExtractCLITools"
		BeforeTargets="BuildAllImages"
		Condition="!Exists('$(Utmt)')">

		<MakeDir Directories="$(LocalUtmtDir)"/>
		<Exec
			Condition="$([MSBuild]::IsOSPlatform('Linux'))"
		    Command='unzip -o "$(UtmtCliZipFileLinux)" -d "$(LocalUtmtDir)"' />
		<Exec
			Condition="$([MSBuild]::IsOSPlatform('Windows'))"
			Command='tar -xf "$(UtmtCliZipFileWindows)" -C "$(LocalUtmtDir)"' />
	</Target>

	<Target
		Name="DistExtractImports"
		Condition="!Exists('$(UtmtCliDir)\UndertaleModCli.exe')">

		<MakeDir Directories="$(UtmtCliDir)" />

		<Exec
			Condition="$([MSBuild]::IsOSPlatform('Linux'))"
		    Command='unzip -o "$(UtmtCliZipFileWindows)" -d "$(UtmtCliDir)"' />
		<Exec
			Condition="$([MSBuild]::IsOSPlatform('Windows'))"
			Command='tar -xf "$(UtmtCliZipFileWindows)" -C "$(UtmtCliDir)"' />
	</Target>

	<Target
		Name="DistCreateFolders">

		<MakeDir Directories="$(DistDir)" />
		<MakeDir Directories="$(DistDir)\scripts" />
		<MakeDir Directories="$(DistDir)\tools" />
	</Target>

	<Target
		Name="Dist"
		DependsOnTargets="DistCreateFolders;DistCopySources;DistExtractImports;GenerateVersions">
	</Target>

	<Target
		Name="Test"
		DependsOnTargets="DistCreateFolders;DistCopySources;DistExtractImports;GenerateFakeVersions">
	</Target>

	<Target Name="DistClean">
		<RemoveDir Directories="$(DistDir)"/>
	</Target>

	<Target
		Name="BeforeRelease"
		BeforeTargets="Release"
		DependsOnTargets="LocateGameFolder">

		<!-- <Delete Files="$(GameDir)\patched.win" /> -->
	</Target>

	<Target
		Name="Release"
		DependsOnTargets="Dist">

		<Delete Files="$(ReleaseZipFile)" />
		<Delete Files="$(GameDir)\patched.win" />

		<RemoveDir Directories="$(DistDir)\originals"/>

		<MakeDir Directories="$(ArtifactsDir)" />
		<ZipDirectory
			SourceDirectory="$(DistDir)"
			DestinationFile="$(ReleaseZipFile)"
			Overwrite="true" />

		<Message
			Importance="high"
			Text="Successfully created patch archive at: $(ReleaseZipFile)" />
	</Target>

	<Target
		Name="ImportsClean">

		<Delete Files="$(UtmtCliZipFileWindows)"/>
		<Delete Files="$(UtmtCliZipFileLinux)"/>
	</Target>

	<Target
		Name="ReleaseClean"
		DependsOnTargets="ImportsClean;DistClean">
	</Target>

	<Target
		Name="Spotless">

		<RemoveDir Directories="$(DistRoot);$(ImportsDir)"/>
	</Target>

	<Target
		Name="LocateGameFolder"
		BeforeTargets=""
		Condition="'$(GameDir)' == ''">

		<Exec
    	    Command='bash "$(BuildToolsDir)/Get-SteamAppPath.sh" 1374840'
			Condition="$([MSBuild]::IsOSPlatform('Linux'))"
          	ConsoleToMSBuild="true"
          	StandardOutputImportance="Low">

			<Output TaskParameter="ConsoleOutput" PropertyName="GameDir"/>
		</Exec>
		<Exec
  			Command='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(BuildToolsDir)\Get-SteamAppPath.ps1" 1374840'
          	Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          	ConsoleToMSBuild="true"
          	StandardOutputImportance="Low">

			<Output TaskParameter="ConsoleOutput" PropertyName="GameDir"/>
		</Exec>

		<Message
			Importance="high"
			Text="Successfully found game folder at: $(GameDir)" />
		<Error
			Text="Couldn't locate the Dark Deity install folder"
         	Condition="'$(GameDir)' == '' Or !Exists('$(GameDir)')" />
	</Target>


	<PropertyGroup>
		<Script1>$(ScriptsDir)\nongmlmods.csx</Script1>
		<Script2>$(ScriptsDir)\scriptupdater.csx</Script2>
		<HashesAll>$(DistDir)\scripts\versions.csv</HashesAll>
	</PropertyGroup>
	
	<ItemGroup>
		<ScriptSources
			Include="$(MSBuildProjectDirectory)\distsrc\scripts\*.gml;$(MSBuildProjectDirectory)\distsrc\scripts\*.csx"/>
	</ItemGroup>

	<Target
		Name="BuildAllImages"
		Inputs="$(MSBuildProjectDirectory\images\%(Distro.Identity)\data.win;@(ScriptSources)"
		Outputs="$(MSBuildProjectDirectory\images\%(Distro.Identity)\patched.win">
		<PropertyGroup>
			<ImagesDir>$(MSBuildProjectDirectory)\images\%(Distro.Identity)</ImagesDir>
			<UnpatchedData>$(ImagesDir)\data.win</UnpatchedData>
			<PatchedData>$(ImagesDir)\patched.win</PatchedData>
		</PropertyGroup>
		<Exec
			WorkingDirectory="$(DistDir)"
			Command='"$(Utmt)" load "$(UnpatchedData)" -s "$(Script1)" -s "$(Script2)" -o "$(PatchedData)"'/>
	</Target>		
	
	<Target
		Name="GenerateAllHashes"
		DependsOnTargets="BuildAllImages"
		Inputs="$(MSBuildProjectDirectory)\images\%(Distro.Identity)\data.win;$(MSBuildProjectDirectory)\images\%(Distro.Identity)\patched.win"
		Outputs="$(MSBuildProjectDirectory)\images\%(Distro.Identity)\hashes.csv">
		<PropertyGroup>
			<GenerateHashFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(BuildToolsDir)\Generate-HashFile.sh</GenerateHashFile>
			<GenerateHashFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(BuildToolsDir)\Generate-HashFile.ps1</GenerateHashFile>
			<ImagesDir>$(MSBuildProjectDirectory)\images\%(Distro.Identity)</ImagesDir>
			<Unpatched>$(ImagesDir)\data.win</Unpatched>
			<Patched>$(ImagesDir)\patched.win</Patched>
			<HashFile>$(ImagesDir)\hashes.csv</HashFile>
		</PropertyGroup>

		<Delete Files="$(HashFile)" Condition="Exists('$(HashFile)')"/>
		<Exec
			Condition="$([MSBuild]::IsOSPlatform('Windows'))"
			WorkingDirectory="$(DistDir)"
			Command='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(GenerateHashFile)" -n "%(Distro.Identity)" -d "$(ImagesDir)" -s "$(HashFile)"'/>
		<Exec
			Condition="$([MSBuild]::IsOSPlatform('Linux'))"
			WorkingDirectory="$(DistDir)"
			Command='bash "$(GenerateHashFile)" -n "%(Distro.Identity)" -d "$(ImagesDir)" -s "$(HashFile)"'/>
	</Target>

	<Target
		Name="GenerateVersions"
		DependsOnTargets="GenerateAllHashes"
		Inputs="@(Distro -> '$(MSBuildProjectDirectory)\images\%(Identity)\hashes.csv)')"
		Outputs="$(DistDir)\scripts\versions.csv">
		
		<Exec
			Condition="$([MSBuild]::IsOSPlatform('Windows'))"
			WorkingDirectory="$(DistDir)"
			Command='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(BuildToolsDir)\Generate-Versions.ps1" "$(MSBuildProjectDirectory)\images" "$(DistDir)\scripts\versions.csv"'/>
		<Exec
			Condition="$([MSBuild]::IsOSPlatform('Linux'))"
			WorkingDirectory="$(DistDir)"
			Command='bash "$(BuildToolsDir)/Merge-Csv.sh" --sourceFolder "$(MSBuildProjectDirectory)/images" --outputFile "$(DistDir)/scripts/versions.csv"'/>	
	</Target>
	
	<Target
		Name="GenerateFakeVersions">
		<PropertyGroup>
			<FileContent>"Name","BeforeHash","AfterHash"
"Epic Games","77C9FEB80267D58CD8FBD41ECFB447376CE1A379EAB3F23E5A095D51E50B388D",""
"GOG","753CD3DB8B572EADD3D6EEC196AD9E8FBCD1A6994CDB2E42895D81341076B92D",""
"Steam","77C9FEB80267D58CD8FBD41ECFB447376CE1A379EAB3F23E5A095D51E50B388D",""</FileContent>
		</PropertyGroup>

		<Message
			Text="Generating fake versions.csv file"
			Importance="high" />
		<WriteLinesToFile
			File="$(DistDir)\scripts\versions.csv"	
			Lines="$(FileContent)"
			Overwrite="true"
			Encoding="UTF-8" />
	</Target>
		
	<Target Name="DistCopySources"
		Inputs="@(DistSources)"
		Outputs="@(DistSources-> '$(DistDir)\%(RecursiveDir)%(Filename)%(Extension)')">
		<Message
			Text="Copying docs"
			Importance="high" />
		<Copy
			SourceFiles="@(DistSources)"
			DestinationFiles="@(DistSources-> '$(DistDir)\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true" />
	</Target>
</Project>
